# COPY IN TO pipeline/.env

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_JINA=vi_schema_jina_v4
QDRANT_COLLECTION_E5=vi_schema_E5

# Schema file
SCHEMA_TXT_FILE=vi_schema.txt

# Embedding model
JINA_MODEL=jinaai/jina-embeddings-v4
E5_MODEL=intfloat/multilingual-e5-large
SINGLE_DIM=1024
MAX_LENGTH=512

# LLM (for get_final.py)
LLM_BASE_URL=https://mkp-api.fptcloud.com/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=
INSTRUCTION_LAN=en

# LLM test output file (for llm_table_accuracy.py)
LLM_TEST_OUT=results/enhanced_en_instruction_accuracy.txt

